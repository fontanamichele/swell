swell.jar:
% content swell %content/swell/ contentaccessible=no
  content/swell/window.xhtml  (window.xhtml)
  content/swell/window.css    (window.css)
  content/swell/window.mjs    (window.mjs)
  content/swell/app.mjs       (app.mjs)
  content/swell/sidebar.mjs   (sidebar.mjs)
  content/swell/commandbar.mjs (commandbar.mjs)
  content/swell/menu.mjs      (menu.mjs)
  content/swell/permissions.mjs (permissions.mjs)
  content/swell/toasts.mjs    (toasts.mjs)
  content/swell/downloads.mjs (downloads.mjs)
  content/swell/autofill.mjs  (autofill.mjs)
  content/swell/passwords.mjs (passwords.mjs)
  content/swell/extensions.mjs (extensions.mjs)
  content/swell/extension-actions.mjs (extension-actions.mjs)
  content/swell/menubar.mjs   (menubar.mjs)
  content/swell/media.mjs     (media.mjs)
  content/swell/navbar.mjs    (navbar.mjs)
  content/swell/sidebar-layout.mjs (sidebar-layout.mjs)
  content/swell/space-editor.mjs (space-editor.mjs)
  content/swell/emoji-data.json (emoji-data.json)
  content/swell/emoji-data-LICENSE (emoji-data-LICENSE)
  content/swell/icons/nav-arrow-left.svg (icons/nav-arrow-left.svg)
  content/swell/icons/nav-arrow-right.svg (icons/nav-arrow-right.svg)
  content/swell/icons/refresh.svg (icons/refresh.svg)
  content/swell/icons/xmark.svg (icons/xmark.svg)
  content/swell/icons/copy.svg (icons/copy.svg)
  content/swell/icons/transition-right.svg (icons/transition-right.svg)
  content/swell/icons/plus.svg (icons/plus.svg)
  content/swell/icons/download.svg (icons/download.svg)
  content/swell/icons/link.svg (icons/link.svg)
  content/swell/icons/minus.svg (icons/minus.svg)
  content/swell/icons/LICENSE-iconoir (icons/LICENSE-iconoir)
  content/swell/fonts/AtkinsonHyperlegibleNext.ttf (fonts/AtkinsonHyperlegibleNext.ttf)
  content/swell/fonts/OFL.txt (fonts/OFL.txt)
% content formautofill %content/formautofill/ contentaccessible=no
  content/formautofill/formautofill.css (../../../browser/extensions/formautofill/content/formautofill.css)
