imply_option("MOZ_PLACES", True)
imply_option("MOZ_PROFILE_MIGRATOR", False)
imply_option("MOZ_APP_VENDOR", "Swell")
# The developer tools with their toolbox and inspector, not only the server.
imply_option("MOZ_DEVTOOLS", "all")
imply_option("MOZ_APP_ID", "{4e7da7f4-09d6-4575-8804-2949e41e54ea}")
imply_option("--with-app-basename", "Swell")
imply_option("--with-distribution-id", "dev.swell")
imply_option("BROWSER_CHROME_URL", "chrome://swell/content/window.xhtml")


# Swell's version for scripts (packaging); the build itself reads it as MOZ_APP_VERSION.
@depends(build_environment)
@imports(_from="__builtin__", _import="open")
@imports("os")
def swell_version(build_env):
    path = os.path.join(build_env.topsrcdir, "swell/app/config/version.txt")
    with open(path) as fh:
        return fh.read().strip()


set_config("SWELL_VERSION", swell_version)

include("../../toolkit/moz.configure")


# What `mach package` copies and with which conditions: a cut-down version of
# browser/moz.configure, for macOS and Linux only.
@depends(
    moz_app_name,
    moz_app_displayname,
    toolkit,
    with_system_nspr_option,
    with_system_nss_option,
    moz_child_process_name,
    moz_eme_process_name,
    moz_gpu_process_name,
    target,
    mac_bundle_name,
    moz_pkg_binpath,
    moz_pkg_respath,
)
@imports(_from="mozbuild.packaging", _import="quote_defines")
def package_manifest_defines(
    app_name,
    app_displayname,
    toolkit,
    system_nspr,
    system_nss,
    child_process_name,
    eme_process_name,
    gpu_process_name,
    target,
    mac_bundle_name,
    binpath,
    respath,
):
    defines = [
        f"-DMOZ_APP_NAME={app_name}",
        "-DPREF_DIR=defaults/preferences",
        f"-DMOZ_APP_DISPLAYNAME={app_displayname}",
        "-DJAREXT=",
        f"-DMOZ_CHILD_PROCESS_NAME={child_process_name or ''}",
        f"-DMOZ_EME_PROCESS_NAME={eme_process_name or ''}",
        f"-DMOZ_GPU_PROCESS_NAME={gpu_process_name or ''}",
        f"-DBINPATH={binpath}",
        f"-DRESPATH={respath}",
    ]
    if toolkit == "gtk":
        defines.append("-DMOZ_GTK=1")
    if system_nspr:
        defines.append("-DMOZ_SYSTEM_NSPR=1")
    if system_nss:
        defines.append("-DMOZ_SYSTEM_NSS=1")
    if target.kernel == "Darwin":
        defines.append("-DMOZ_SHARED_MOZGLUE=1")
    if mac_bundle_name:
        defines.append(f"-DAPPNAME={mac_bundle_name}")
    return quote_defines(defines)


set_config("PACKAGE_MANIFEST_DEFINES", package_manifest_defines)


@depends(build_environment.topsrcdir)
@imports(_import="mozpack.path", _as="mozpath")
def package_inputs(topsrcdir):
    installer = mozpath.join(topsrcdir, "swell", "app", "installer")
    return namespace(
        manifest=mozpath.join(installer, "package-manifest.in"),
        removals=mozpath.join(installer, "removed-files.in"),
        allowed_dupes=[mozpath.join(installer, "allowed-dupes.mn")],
    )


set_config("MOZ_PKG_MANIFEST", package_inputs.manifest)
set_config("MOZ_PKG_REMOVALS", package_inputs.removals)
set_config("MOZ_PKG_ALLOWED_DUPES", package_inputs.allowed_dupes)
set_config("MOZ_PKG_FATAL_WARNINGS", True)
