# Cut down from browser/installer/Makefile.in, for macOS and Linux only.

STANDALONE_MAKEFILE := 1
DIST_SUBDIR := app

include $(topsrcdir)/config/rules.mk

MOZ_PKG_REMOVALS = $(srcdir)/removed-files.in
MOZ_PKG_MANIFEST = $(srcdir)/package-manifest.in
MOZ_PKG_DUPEFLAGS = -f $(srcdir)/allowed-dupes.mn
MOZ_PKG_FATAL_WARNINGS = 1

DEFINES += -DMOZ_APP_NAME=$(MOZ_APP_NAME) -DPREF_DIR=defaults/preferences -DMOZ_APP_DISPLAYNAME="$(MOZ_APP_DISPLAYNAME)"
DEFINES += -DJAREXT=

ifeq ($(MOZ_WIDGET_TOOLKIT),gtk)
DEFINES += -DMOZ_GTK=1
endif

ifdef MOZ_SYSTEM_NSPR
DEFINES += -DMOZ_SYSTEM_NSPR=1
endif

DEFINES += -DMOZ_CHILD_PROCESS_NAME=$(MOZ_CHILD_PROCESS_NAME)
DEFINES += -DMOZ_EME_PROCESS_NAME="$(MOZ_EME_PROCESS_NAME)"
DEFINES += -DMOZ_GPU_PROCESS_NAME="$(MOZ_GPU_PROCESS_NAME)"

ifneq (,$(filter Darwin,$(OS_TARGET)))
DEFINES += -DMOZ_SHARED_MOZGLUE=1
endif

include $(topsrcdir)/toolkit/mozapps/installer/packager.mk

BINPATH = $(MOZ_PKG_BINPATH)
ifeq (Darwin,$(OS_TARGET))
DEFINES += -DAPPNAME='$(MOZ_MACBUNDLE_NAME)'
endif
DEFINES += -DBINPATH='$(BINPATH)'

RESPATH = $(MOZ_PKG_RESPATH)
DEFINES += -DRESPATH='$(RESPATH)'

LPROJ_ROOT = $(firstword $(subst -, ,$(AB_CD)))
DEFINES += -DLPROJ_ROOT=$(LPROJ_ROOT)
