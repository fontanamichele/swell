DIST_SUBDIR = ""

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    mac_app_name = CONFIG["MOZ_APP_DISPLAYNAME"]
    if CONFIG["MOZ_DEBUG"]:
        mac_app_name += "Debug"
    GeneratedFile(
        "Info.plist",
        script="/browser/app/generate_info_plist.py",
        inputs=["macbuild/Contents/Info.plist.in"],
        flags=[mac_app_name],
        extra_deps=["!/buildid.h"],
    )
    GeneratedFile(
        "InfoPlist.strings",
        script="/python/mozbuild/mozbuild/action/preprocessor.py",
        entry_point="generate",
        inputs=["macbuild/Contents/Resources/English.lproj/InfoPlist.strings.in"],
        flags=[
            "-Fsubstitution",
            "--output-encoding",
            "utf-16",
            f"-DMAC_APP_NAME={mac_app_name}",
        ],
    )
    branding = f"/{CONFIG['MOZ_BRANDING_DIRECTORY']}"
    MacOSBundle(
        f"!/dist/{CONFIG['MOZ_MACBUNDLE_NAME']}",
        skeleton="macbuild/Contents",
        info_plist="!Info.plist",
        strings="!InfoPlist.strings",
        lproj="en.lproj",
        stage=f"!/{FINAL_TARGET}",
        macos_files="!macbuild/Contents/MacOS-files.txt",
        macos_copy_files="macbuild/Contents/MacOS-files-copy.in",
        binaries=[
            (f"!/{FINAL_TARGET}/{CONFIG['MOZ_APP_NAME']}", CONFIG["MOZ_APP_NAME"])
        ],
        extra_files=[(f"{branding}/swell.icns", "Resources/swell.icns")],
        pkginfo="APPL????",
    )

if CONFIG["MOZ_MACBUNDLE_NAME"]:
    DIRS += ["macbuild/Contents"]

GeckoProgram(CONFIG["MOZ_APP_NAME"], linkage="standalone")

if CONFIG["OS_ARCH"] != "WINNT" and CONFIG["COMPILE_ENVIRONMENT"]:
    FINAL_TARGET_FILES += [
        (
            f"!/{FINAL_TARGET}/" + CONFIG["MOZ_APP_NAME"] + CONFIG["BIN_SUFFIX"],
            CONFIG["MOZ_APP_NAME"] + "-bin" + CONFIG["BIN_SUFFIX"],
        )
    ]

SOURCES += [
    "ApplicationData.cpp",
    "nsSwellApp.cpp",
]

LOCAL_INCLUDES += [
    "!/build",
    "/toolkit/xre",
    "/xpcom/base",
    "/xpcom/build",
]

if CONFIG["OS_ARCH"] == "Darwin":
    OS_LIBS += [
        "-framework CoreFoundation",
    ]

DisableStlWrapping()

if CONFIG["HAVE_CLOCK_MONOTONIC"]:
    OS_LIBS += CONFIG["REALTIME_LIBS"]

SOURCE_HEADERS += [
    "ApplicationData.h",
    "SwellDefines.h",
]
