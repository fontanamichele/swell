+static bool IsolatedByUserContext() {
+  return StaticPrefs::places_history_isolate_by_user_context();
+}
+
+// The content processes that host pages of one container. A process only ever
+// hosts a single container (RemoteType::SharedWeb keeps it in the remote type).
+static History::ContentParentSet ContentParentsOfContainer(
+    uint32_t aUserContextId) {
+  History::ContentParentSet processes;
+  nsTArray<dom::ContentParent*> all;
+  dom::ContentParent::GetAll(all);
+  for (dom::ContentParent* process : all) {
+    if (process->GetRemoteType().UserContextId() == aUserContextId) {
+      processes.Insert(process);
+    }
+  }
+  return processes;
+}
