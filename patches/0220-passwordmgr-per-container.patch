Purpose: Saved logins have no notion of container: the login manager, its prompts and "never save" choices are one set for the whole profile. Add pref-gated seams so an application can keep logins per container: signon.isolate_by_user_context makes LoginManagerParent talk to a per-container view of the login manager (LoginHelper.loginsFor: searches, changes and the login-saving permission carry the container of the page), signon.storageModuleURI names the storage module the login manager loads, and signon.prompterModuleURI the module that asks to save or update a login. All default to Firefox's behaviour. Upstreamable: the per-container view yes, behind the pref; the two module seams are small.
Test: MOZCONFIG=swell/mozconfig ./mach test swell/tests/app/isolation/browser/browser_logins.js --headless

diff --git a/toolkit/components/passwordmgr/LoginHelper.sys.mjs b/toolkit/components/passwordmgr/LoginHelper.sys.mjs
index d3dd5557b9aa..41f9a0d3604a 100644
--- a/toolkit/components/passwordmgr/LoginHelper.sys.mjs
+++ b/toolkit/components/passwordmgr/LoginHelper.sys.mjs
@@ -392,10 +392,133 @@ const OS_AUTH_FOR_PASSWORDS_BOOL_PREF =
 // token.login() spins a nested event loop a second requestReauth() can run in.
 let gPrimaryPasswordReauthDepth = 0;
 
+// Keep saved logins apart per container (userContextId) instead of sharing
+// them between all containers of a profile.
+XPCOMUtils.defineLazyPreferenceGetter(
+  lazy,
+  "ISOLATE_BY_USER_CONTEXT",
+  "signon.isolate_by_user_context",
+  false
+);
+
+const PERMISSION_SAVE_LOGINS = "login-saving";
+
+/**
+ * The login manager as one container sees it: every search, change and
+ * "never save" choice is for that container only. The storage behind the
+ * login manager gets the container as `userContextId` on the match data and
+ * on the login objects.
+ */
+class ContainerLogins {
+  #userContextId;
+
+  constructor(userContextId) {
+    this.#userContextId = userContextId;
+  }
+
+  #tag(login) {
+    if (login) {
+      (login.wrappedJSObject ?? login).userContextId = this.#userContextId;
+    }
+    return login;
+  }
+
+  #principal(origin) {
+    return Services.scriptSecurityManager.createContentPrincipal(
+      Services.io.newURI(origin),
+      { userContextId: this.#userContextId }
+    );
+  }
+
+  get isLoggedIn() {
+    return Services.logins.isLoggedIn;
+  }
+
+  get uiBusy() {
+    return Services.logins.uiBusy;
+  }
+
+  searchLoginsAsync(matchData) {
+    return Services.logins.searchLoginsAsync({
+      ...matchData,
+      userContextId: this.#userContextId,
+    });
+  }
+
+  async countLoginsAsync(origin, formActionOrigin, httpRealm) {
+    const found = await this.searchLoginsAsync({
+      origin,
+      formActionOrigin,
+      httpRealm,
+    });
+    return found.length;
+  }
+
+  addLoginAsync(login) {
+    return Services.logins.addLoginAsync(this.#tag(login));
+  }
+
+  modifyLoginAsync(oldLogin, newLogin) {
+    return Services.logins.modifyLoginAsync(this.#tag(oldLogin), newLogin);
+  }
+
+  removeLoginAsync(login) {
+    return Services.logins.removeLoginAsync(this.#tag(login));
+  }
+
+  recordPasswordUseAsync(login, ...args) {
+    return Services.logins.recordPasswordUseAsync(this.#tag(login), ...args);
+  }
+
+  getLoginSavingEnabled(origin) {
+    if (!LoginHelper.enabled) {
+      return false;
+    }
+    try {
+      return (
+        Services.perms.testPermissionFromPrincipal(
+          this.#principal(origin),
+          PERMISSION_SAVE_LOGINS
+        ) != Services.perms.DENY_ACTION
+      );
+    } catch (e) {
+      return false;
+    }
+  }
+
+  setLoginSavingEnabled(origin, enabled) {
+    LoginHelper.checkOriginValue(origin);
+    if (enabled) {
+      Services.perms.removeFromPrincipal(
+        this.#principal(origin),
+        PERMISSION_SAVE_LOGINS
+      );
+    } else {
+      Services.perms.addFromPrincipal(
+        this.#principal(origin),
+        PERMISSION_SAVE_LOGINS,
+        Services.perms.DENY_ACTION
+      );
+    }
+  }
+}
+
 /**
  * Contains functions shared by different Login Manager components.
  */
 export const LoginHelper = {
+  /**
+   * The login manager for one container: its own logins, its own "never save"
+   * choices. The login manager itself when containers are not kept apart.
+   *
+   * @param {number} userContextId
+   */
+  loginsFor(userContextId) {
+    return lazy.ISOLATE_BY_USER_CONTEXT
+      ? new ContainerLogins(userContextId ?? 0)
+      : Services.logins;
+  },
+
   debug: null,
   enabled: null,
   storageEnabled: null,
