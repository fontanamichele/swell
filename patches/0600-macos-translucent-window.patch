+++ b/dom/xul/ChromeObserver.cpp
@@ -84,6 +84,8 @@ void ChromeObserver::AttributeChanged(dom::Element* aElement,
       SetHideTitlebarSeparator(added);
     } else if (aName == nsGkAtoms::windowsmica) {
       SetMica(added);
+    } else if (aName == nsGkAtoms::macostranslucent) {
+      SetTranslucent(added);
     }
   }
   if (aName == nsGkAtoms::localedir) {
@@ -106,6 +108,19 @@ void ChromeObserver::SetMica(bool aEnable) {
   }
 }
 
+void ChromeObserver::SetTranslucent(bool aEnable) {
+#ifdef XP_MACOSX
+  // A top level window is opaque, so what the document leaves clear is not
+  // transparent but the window's own colour; with this the native sidebar
+  // material (vibrancy) behind the document can show through.
+  if (nsIWidget* mainWidget = GetWindowWidget()) {
+    mainWidget->SetTransparencyMode(aEnable
+                                        ? widget::TransparencyMode::Transparent
+                                        : widget::TransparencyMode::Opaque);
+  }
+#endif
+}
