diff --git a/toolkit/components/satchel/test/unit/test_history_container.js b/toolkit/components/satchel/test/unit/test_history_container.js
new file mode 100644
index 000000000000..1b9ef0bcecd3
--- /dev/null
+++ b/toolkit/components/satchel/test/unit/test_history_container.js
@@ -0,0 +1,65 @@
+/* Any copyright is dedicated to the Public Domain.
+ * https://creativecommons.org/publicdomain/zero/1.0/ */
+
+// Tests that entries can be kept per container (userContextId).
+
+add_task(async function test_entries_per_container() {
+  const field = "field-container";
+  const search = (userContextId, searchString = "va") =>
+    FormHistory.getAutoCompleteResults(searchString, {
+      fieldname: field,
+      userContextId,
+    }).then(results => results.map(r => r.text));
+
+  await FormHistory.update([
+    { op: "add", fieldname: field, value: "value-1", userContextId: 1 },
+    { op: "add", fieldname: field, value: "value-2", userContextId: 2 },
+    { op: "bump", fieldname: field, value: "value-both", userContextId: 1 },
+    { op: "bump", fieldname: field, value: "value-both", userContextId: 2 },
+    { op: "add", fieldname: field, value: "value-0" },
+  ]);
+
+  Assert.equal(await FormHistory.count({ fieldname: field }), 5);
+  Assert.deepEqual((await search(1)).sort(), ["value-1", "value-both"]);
+  Assert.deepEqual((await search(2)).sort(), ["value-2", "value-both"]);
+  Assert.deepEqual(await search(0), ["value-0"]);
+  Assert.deepEqual(await search(3), []);
+  Assert.equal(
+    (await FormHistory.getAutoCompleteResults("va", { fieldname: field }))
+      .length,
+    5,
+    "without a container every entry is found"
+  );
+
+  info("Bumping again reuses the entry of the same container");
+  await FormHistory.update({
+    op: "bump",
+    fieldname: field,
+    value: "value-both",
+    userContextId: 1,
+  });
+  const rows = await FormHistory.search(["timesUsed", "userContextId"], {
+    fieldname: field,
+    value: "value-both",
+  });
+  Assert.deepEqual(
+    rows.map(r => [r.userContextId, r.timesUsed]).sort(),
+    [
+      [1, 2],
+      [2, 1],
+    ]
+  );
+
+  info("Removing in one container leaves the others");
+  await FormHistory.update({
+    op: "remove",
+    fieldname: field,
+    value: "value-both",
+    userContextId: 1,
+  });
+  Assert.deepEqual((await search(1)).sort(), ["value-1"]);
+  Assert.deepEqual((await search(2)).sort(), ["value-2", "value-both"]);
+
+  await FormHistory.update({ op: "remove", fieldname: field });
+  Assert.equal(await FormHistory.count({ fieldname: field }), 0);
+});
