diff --git a/toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs b/toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs
index 3db4a743ec59..86da9f73a4a9 100644
--- a/toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs
+++ b/toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs
@@ -503,3 +503,47 @@ export class FormAutofillStorage extends FormAutofillStorageBase {
 export const formAutofillStorage = new FormAutofillStorage(
   PathUtils.join(PathUtils.profileDir, PROFILE_JSON_FILE_NAME)
 );
+
+// Each container (userContextId) can have a storage of its own, kept in its own
+// file, when extensions.formautofill.isolate_by_user_context is set. The default
+// container uses the singleton above.
+const containerStorages = new Map();
+
+export function getFormAutofillStorageFor(userContextId) {
+  if (!userContextId) {
+    return formAutofillStorage;
+  }
+  let storage = containerStorages.get(userContextId);
+  if (!storage) {
+    storage = new FormAutofillStorage(
+      PathUtils.join(
+        PathUtils.profileDir,
+        `autofill-profiles-${userContextId}.json`
+      )
+    );
+    containerStorages.set(userContextId, storage);
+  }
+  return storage;
+}
+
+export function openedFormAutofillStorages() {
+  return [formAutofillStorage, ...containerStorages.values()];
+}
+
+// Opens the storage of every container that has a file in the profile.
+export async function openExistingContainerStorages() {
+  let paths = [];
+  try {
+    paths = await IOUtils.getChildren(PathUtils.profileDir);
+  } catch (e) {
+    return;
+  }
+  for (const path of paths) {
+    const match = /^autofill-profiles-(\d+)\.json$/.exec(
+      PathUtils.filename(path)
+    );
+    if (match) {
+      getFormAutofillStorageFor(Number(match[1]));
+    }
+  }
+}
