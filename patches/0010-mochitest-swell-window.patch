Purpose: let mach and the browser-chrome harness run in Swell. mach: add the is_swell
condition and enable the browser-chrome flavor for it. Harness: Swell's main window has
windowtype navigator:browser (so Marionette, the window mediator and the harness find it)
but is not a browser.xhtml window, so loadMochitest must not call win.openLinkIn.
Test: ./mach test swell/tests/app/browser --headless
Upstreamable: no (names a downstream application).

diff --git a/python/mozbuild/mozbuild/base.py b/python/mozbuild/mozbuild/base.py
index 08f41d502c10..f131eff82185 100644
--- a/python/mozbuild/mozbuild/base.py
+++ b/python/mozbuild/mozbuild/base.py
@@ -1071,6 +1071,13 @@ class MachCommandConditions:
             return build_obj.substs.get("MOZ_BUILD_APP") == "browser"
         return False
 
+    @staticmethod
+    def is_swell(build_obj):
+        """Must have a Swell build."""
+        if hasattr(build_obj, "substs"):
+            return build_obj.substs.get("MOZ_BUILD_APP") == "swell/app"
+        return False
+
     @staticmethod
     def is_jsshell(build_obj):
         """Must have a jsshell build."""
@@ -1137,9 +1144,11 @@ class MachCommandConditions:
     @staticmethod
     def has_build(build_obj):
         """Must have a build."""
-        return MachCommandConditions.is_firefox_or_android(
-            build_obj
-        ) or MachCommandConditions.is_thunderbird(build_obj)
+        return (
+            MachCommandConditions.is_firefox_or_android(build_obj)
+            or MachCommandConditions.is_thunderbird(build_obj)
+            or MachCommandConditions.is_swell(build_obj)
+        )
 
     @staticmethod
     def has_build_or_shell(build_obj):
