@@ -1117,6 +1117,47 @@ export class ExtensionData {
     return results;
   }
 
+  // A copy of an add-on that is made for one container carries the container
+  // in its id: "name@domain" becomes "name--s<container>@domain", and "{guid}"
+  // becomes "guid--s<container>@derived.swell.invalid".
+
+  /**
+   * The container a derived copy is bound to, or -1 for any other add-on.
+   *
+   * @param {string} id
+   * @returns {number}
+   */
+  static boundUserContextIdOf(id) {
+    const match = /--s(\d+)@[^@]+$/.exec(id ?? "");
+    return match ? Number(match[1]) : -1;
+  }
+
+  /**
+   * The id of the add-on a derived copy was made from; any other id is its own.
+   *
+   * @param {string} id
+   * @returns {string}
+   */
+  static originalIdOf(id) {
+    const match = /^(.+)--s\d+@([^@]+)$/.exec(id ?? "");
+    if (!match) {
+      return id;
+    }
+    return match[2] == "derived.swell.invalid"
+      ? `{${match[1]}}`
+      : `${match[1]}@${match[2]}`;
+  }
+
+  // The userContextId this copy is bound to, or -1.
+  get boundUserContextId() {
+    return ExtensionData.boundUserContextIdOf(this.id);
+  }
+
+  get boundOriginAttributesPatterns() {
+    let bound = this.boundUserContextId;
+    return bound >= 0 ? [{ userContextId: bound }] : null;
+  }
+
