@@ -271,3 +271,39 @@ add_task(async function test_DownloadHistory() {
   allView2.expected = allView.expected;
   await allView2.waitForExpected();
 });
+
+add_task(async function test_DownloadHistory_userContextId() {
+  await PlacesUtils.history.clear();
+
+  for (let userContextId of [0, 2]) {
+    const sourceUrl = httpUrl(`container-${userContextId}.txt`);
+    const targetFile = getTempFile(
+      `${TEST_TARGET_FILE_NAME}-container-${userContextId}`
+    );
+    const download = await Downloads.createDownload({
+      source: { url: sourceUrl, userContextId },
+      target: { path: targetFile.path },
+      startTime: new Date(),
+      succeeded: true,
+    });
+
+    const visit = promiseWaitForVisit(sourceUrl);
+    await DownloadHistory.addDownloadToHistory(download);
+    await visit;
+
+    const db = await PlacesUtils.promiseDBConnection();
+    const rows = await db.execute(
+      `SELECT v.userContextId FROM moz_historyvisits v
+       JOIN moz_places h ON h.id = v.place_id
+       WHERE h.url_hash = hash(:url) AND h.url = :url`,
+      { url: sourceUrl }
+    );
+    Assert.deepEqual(
+      rows.map(r => r.getResultByName("userContextId")),
+      [userContextId],
+      "The download visit is stored in the container of the download"
+    );
+  }
+
+  await PlacesUtils.history.clear();
+});
