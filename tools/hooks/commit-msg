#!/bin/sh
# Enforces conventional commits. (The version bump is tools/hooks/post-commit: the commit's
# contents are fixed before this hook runs, so the bump has to follow it.)
#
#   type(scope)!: summary     types: feat fix perf refactor test docs build chore style ci patch
#
# Enabled by `core.hooksPath tools/hooks`, which tools/setup.sh sets.
set -eu

message=$1
subject=$(sed -n '1p' "$message")

case "$subject" in
Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|perf|refactor|test|docs|build|chore|style|ci|patch)(\([a-z0-9._-]+\))?!?: .+'
if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<MSG
error: commit message is not a conventional commit:
  $subject
expected  type(scope): summary   with type one of
  feat fix perf refactor test docs build chore style ci patch
e.g.  feat(app): add a find bar     patch(firefox): 0030-name what changed
MSG
  exit 1
fi
