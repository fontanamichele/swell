#!/bin/sh
# Bumps Swell's version (app/config/version.txt) on every commit and folds the change into
# that commit.
#
#   feat -> minor; a breaking change (`!` or a "BREAKING CHANGE:" line) -> major, or minor
#   while the version is still 0.x; everything else -> patch.
#
# Skipped when SWELL_NO_BUMP=1, during a rebase or cherry-pick, and for a commit that already
# changes the version file (so an amend does not bump twice).
set -eu

[ -z "${SWELL_NO_BUMP:-}" ] || exit 0
[ -z "${SWELL_BUMPING:-}" ] || exit 0

root=$(git rev-parse --show-toplevel)
gitdir=$(git rev-parse --git-dir)
for marker in rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD; do
  [ ! -e "$gitdir/$marker" ] || exit 0
done

if git diff-tree --no-commit-id --name-only -r HEAD | grep -qx 'app/config/version.txt'; then
  exit 0
fi

subject=$(git log -1 --format=%s)
case "$subject" in
Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

type=${subject%%[(!:]*}
breaking=no
case "$subject" in *"!:"*) breaking=yes ;; esac
git log -1 --format=%B | grep -q '^BREAKING CHANGE:' && breaking=yes

current=$(cat "$root/app/config/version.txt")
kind=patch
[ "$type" = feat ] && kind=minor
if [ "$breaking" = yes ]; then
  case "$current" in 0.*) kind=minor ;; *) kind=major ;; esac
fi

version=$("$root/tools/bump-version.sh" "$kind")
SWELL_BUMPING=1 git -C "$root" commit -q --amend --no-edit --no-verify --only -- app/config/version.txt
echo "swell version -> $version ($kind)"
